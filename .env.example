# Example environment configuration for spin system simulations.
# Create a file named '.env' based on this template and modify the paths as needed.


# Root directory for generated simulation data.
SPIN_SYSTEM_DATA_ROOT=/home/host/storage/data

# Root directory for trained neural network model files.
SPIN_SYSTEM_MODEL_ROOT=/home/host/storage/models

# Root directory for generated outputs such as plots and evaluations.
SPIN_SYSTEM_OUTPUT_ROOT=/home/host/storage/output
